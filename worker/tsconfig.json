{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "../shared/cryo-rules.ts",
    "../shared/job-pay-rules.ts",
    "../shared/worlds.ts",
    "../shared/hacker-rules.ts",
    "../shared/safe-pin-rules.ts"
  ]
}
