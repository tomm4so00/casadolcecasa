          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
        },
        "shifts": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
        }
      }
    },
    "sims_chat": {
      ".read": "(auth != null && auth.token.firebase.sign_in_provider === 'google.com') && root.child('sims_accounts').child(auth.uid).child('playerId').isString()",
      ".indexOn": ["t"],
      "$key": {
        ".write": "((auth != null && auth.token.firebase.sign_in_provider === 'google.com') && root.child('sims_accounts').child(auth.uid).child('playerId').isString()) && ((!newData.exists() && data.child('id').val() === root.child('sims_accounts').child(auth.uid).child('playerId').val()) || (!data.exists() && newData.child('id').val() === root.child('sims_accounts').child(auth.uid).child('playerId').val()))",
        ".validate": "newData.hasChildren(['id','name','text','t'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 140"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
        }
      }
    },
    "sims_interactions": {
      "$pid": {
        ".read": "(auth != null && auth.token.firebase.sign_in_provider === 'google.com') && root.child('sims_accounts').child(auth.uid).child('playerId').val() === $pid",
        "$key": {
          ".write": "((auth != null && auth.token.firebase.sign_in_provider === 'google.com') && root.child('sims_accounts').child(auth.uid).child('playerId').isString()) && ((!newData.exists() && root.child('sims_accounts').child(auth.uid).child('playerId').val() === $pid) || (!data.exists() && newData.child('from').val() === root.child('sims_accounts').child(auth.uid).child('playerId').val()))",
          ".validate": "newData.hasChildren(['type','from','fromName','t']) && newData.child('type').val().matches(/^(talk|praise|insult|punch|food|money_notice|drug|drugReturn)$/)",
          "from": {
            ".validate": "newData.isString() && newData.val().length <= 140"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "type": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
          },
          "amt": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000"
          }
        }
      }
    },
    "sims_graveyard": {
      ".read": "(auth != null && auth.token.firebase.sign_in_provider === 'google.com') && root.child('sims_accounts').child(auth.uid).child('playerId').isString()",
      "$pid": {
        ".write": "(auth != null && auth.token.firebase.sign_in_provider === 'google.com') && root.child('sims_accounts').child(auth.uid).child('playerId').val() === $pid",
        ".validate": "newData.hasChildren(['name','deadAt','days'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "deadAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
        },
        "days": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
        },
        "visitors": {
          "$visitor": {
            ".write": "((auth != null && auth.token.firebase.sign_in_provider === 'google.com') && root.child('sims_accounts').child(auth.uid).child('playerId').isString()) && root.child('sims_accounts').child(auth.uid).child('playerId').val() === $visitor",
            ".validate": "newData.isString() && newData.val().length <= 20"
          }
        }
      }
    }
  }
